# Keep the build context clean and prevent a local .env (with localhost ports)
# from leaking into the image — compose injects the correct env at runtime.
.env
.git
.gitignore
__pycache__/
*.pyc
.venv/
venv/
.DS_Store
scripts/benchmark_results.csv
scripts/benchmark_latency.png
scripts/benchmark_slide.pptx
