# Copy to .env for local (non-docker) runs. Loaded automatically by app/db.py.
# docker-compose sets these via the `environment:` block instead.

MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=gigtrack
MYSQL_PASSWORD=gigtrack_pw
MYSQL_DB=gigtrack

MONGO_URI=mongodb://localhost:27017
REDIS_URL=redis://localhost:6379/0

# Generate a real value for anything non-local: python -c "import secrets; print(secrets.token_hex(32))"
FLASK_SECRET=dev-secret-change-me

# Object storage (S3-compatible). For local MinIO via docker-compose use the
# values below. For real AWS S3 / Cloudflare R2, set S3_ENDPOINT to their
# endpoint and use real keys - the code is otherwise unchanged.
# Leave S3_ENDPOINT blank to disable storage (reviews still post, sans photos).
S3_ENDPOINT=http://localhost:9000
S3_PUBLIC_URL=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=gigtrack-media
S3_REGION=us-east-1

# Artist photos are fetched from this placeholder-portrait service by
# scripts/fetch_artist_images.py and stored in MinIO. Override only if needed.
# AVATAR_BASE=https://i.pravatar.cc
